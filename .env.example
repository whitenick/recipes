# Example environment for the Recipes AI Search (WILS-17).
# Copy to `.env` and fill in real values. Never commit real keys.
#
# ── Server side (VPS, when running search/indexer.js) ─────────────
# MEILI_URL=http://localhost:7700
# MEILI_MASTER_KEY=<set at docker compose up; keep on the VPS only>
# MEILI_INDEX=recipes
#
# ── Site build (read by src/search.js via Vite; build-time only) ──
# Leave these empty to keep the static local-substring search.
# VITE_SEARCH_ENDPOINT=https://search.example.com
# VITE_SEARCH_KEY=<search-only key — never the master key>
# VITE_SEARCH_INDEX=recipes
# VITE_SEARCH_HYBRID=true